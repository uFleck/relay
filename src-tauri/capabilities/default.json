{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window. Native message/confirm dialogs are deliberately not granted.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:allow-open",
    "process:default",
    "updater:default",
    "notification:default",
    "autostart:default",
    "global-shortcut:default"
  ]
}
